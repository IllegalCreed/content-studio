{
  "name": "@illegalcreed/content-studio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "description": "Cross-project content-production control plane with owner-controlled publishing handoffs",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./host": "./dist/host.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "content-studio": "./dist/cli.mjs",
    "content-studio-host": "./dist/host.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsdown && pnpm --filter @illegalcreed/content-studio-workbench build",
    "coverage": "vitest run --coverage",
    "dev:workbench": "pnpm --filter @illegalcreed/content-studio-workbench dev",
    "generate:example": "pnpm build && node dist/cli.mjs generate --project examples/algorithm-visualizer/project.json --campaign examples/algorithm-visualizer/campaign.json --out .content-studio/example",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run && pnpm --filter @illegalcreed/content-studio-workbench test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && pnpm --filter @illegalcreed/content-studio-workbench type-check",
    "verify": "pnpm lint:check && pnpm type-check && pnpm test && pnpm build"
  },
  "dependencies": {
    "ffmpeg-static": "catalog:",
    "playwright": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
